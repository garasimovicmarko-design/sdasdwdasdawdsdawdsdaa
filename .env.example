# Postgres connection string. Matches docker-compose.yml defaults for local dev.
DATABASE_URL="postgresql://adamas:adamas_dev_password@localhost:5432/adamas?schema=public"

# Random string, 32+ characters, used to encrypt the admin session cookie.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""

# Public site URL, used for canonical links, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Map tiles provider — currently only "osm" (OpenStreetMap, free, no key) is implemented.
NEXT_PUBLIC_MAP_PROVIDER="osm"

# Club Instagram, shown in header/footer share links.
INSTAGRAM_URL="https://www.instagram.com/adamas_ua"

# Used ONLY by `npm run db:seed` to create the first admin account.
# Leave unset to skip admin creation (you can create one later via a script).
SEED_ADMIN_EMAIL="admin@adamas.local"
SEED_ADMIN_PASSWORD=""
